# Course materials (not our own work; keep out of the repo, especially if remote is public)
project-guides/

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example
*.key

# Python
.venv/
__pycache__/
*.pyc
.uv/

# Node / n8n
node_modules/

# n8n local instance data — DB, credential store, cache, owner account
.n8n/

# n8n server stdout — not a deliverable, just process output; the run-record
# evidence lives in n8n/logs/runs.jsonl, which IS tracked.
n8n/logs/*.log

# CrewAI per-run interim artifacts (evidence, drafts). Force-add a run you want to keep as a deliverable.
crewai/runs/

# Google OAuth client secret + token for the CrewAI Docs Writer (never commit)
crewai/.google/

# MCP research-result cache (mcp-server/research/cache.py)
mcp-server/.cache/
n8n/docs_writer/fixtures/*/rendered_doc.txt

# Blind-review unblinding keys: commit only after scoring is done
eval/**/packets/key.json
