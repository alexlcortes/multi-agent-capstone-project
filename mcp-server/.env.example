# Which provider the five research tools call through (see research/factory.py).
# Must be one of: serpapi, tavily. No silent default in production -- set this explicitly.
SEARCH_PROVIDER=tavily

SERPAPI_API_KEY=your-serpapi-key-here
TAVILY_API_KEY=your-tavily-key-here

# Research-result cache (research/cache.py). Hits keep their original retrieval_timestamp.
# Hours a cached search stays valid; 0 turns the cache off.
RESEARCH_CACHE_TTL_HOURS=24
