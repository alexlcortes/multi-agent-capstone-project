{
  "$comment": "Field-to-section map for the Docs Writer in both implementations. Layout rules live in gtm_document_template.md; this file says which artifact field fills which section, table column or slot. Paths: 'analyst.' / 'strategy.' / 'evidence.' + schema property path, '[]' = each array item. A cited field (CitedField, StrategyCitedField, DerivedField) is mapped as one unit: its value goes in the slot and its ids/basis follow the template's citation convention. 'at' is the primary place; 'also' lists other places the same field is read (executive summary, appendices, sort keys). 'section': null means deliberately not rendered, with a 'reason'. crewai/tests/test_docs_field_map.py fails if a schema field is missing here or a path here is not in the schema.",

  "sections": [
    {"id": "header", "heading": null},
    {"id": "1", "heading": "Executive summary"},
    {"id": "2", "heading": "Research scope"},
    {"id": "3", "heading": "Evidence table"},
    {"id": "4", "heading": "Competitor comparison"},
    {"id": "4.1", "heading": "Snapshot"},
    {"id": "4.2", "heading": "Features and contract terms"},
    {"id": "5", "heading": "Pricing matrix"},
    {"id": "6", "heading": "Market analysis"},
    {"id": "6.1", "heading": "Market themes"},
    {"id": "6.2", "heading": "SWOT"},
    {"id": "6.3", "heading": "7P market analysis"},
    {"id": "7", "heading": "GTM recommendations"},
    {"id": "7.1", "heading": "Ideal customer profiles"},
    {"id": "7.2", "heading": "Customer pains and desired outcomes"},
    {"id": "7.3", "heading": "Value proposition"},
    {"id": "7.4", "heading": "Positioning and differentiation"},
    {"id": "7.5", "heading": "Message pillars"},
    {"id": "7.6", "heading": "Recommended channels"},
    {"id": "7.7", "heading": "Launch phases and activities"},
    {"id": "7.8", "heading": "Success metrics"},
    {"id": "8", "heading": "Assumptions, risks and open questions"},
    {"id": "8.1", "heading": "Assumptions"},
    {"id": "8.2", "heading": "Unknowns"},
    {"id": "8.3", "heading": "Conflicting evidence"},
    {"id": "8.4", "heading": "Risks"},
    {"id": "8.5", "heading": "Follow-up research"},
    {"id": "A", "heading": "Appendix A: Analyst findings referenced"},
    {"id": "B", "heading": "Appendix B: Citations"}
  ],

  "selection_rules": {
    "exec_why_they_switch": "strategy.pains_and_outcomes[] with the highest severity (high > medium > low); ties -> first in array order",
    "exec_first_moves_phase": "strategy.launch_phases[] with the lowest sequence_order",
    "exec_first_moves_channels": "strategy.channels[] with budget_tier = low, in array order; if none, the lowest tier present",
    "exec_top_risk": "strategy.risks[] with the highest impact, then highest likelihood; ties -> first in array order",
    "cited_evidence": "an evidence record is 'cited' when its evidence_id appears anywhere in the rendered body (sections 1-8 and Appendix A); only cited records appear in Table 3 and Appendix B",
    "appendix_a_findings": "THEME-/SWOT-/ASM-/UNK- ids that appear in any strategy supporting_ids"
  },

