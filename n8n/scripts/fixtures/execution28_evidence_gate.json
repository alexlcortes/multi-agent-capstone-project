  "seven_p_analysis": {
   "product": {
    "market_description": {
     "value": "The residential home‑internet market in Ocala and surrounding Marion County is a mix of incumbent cable/HFC (Spectrum), fiber expansions (Quantum, AT&T, regional ISPs), and emerging fixed wireless (T‑Mobile). Providers differentiate on speed tiers (100 Mbps to multi‑gig), bundle offers (TV, mobile), and local service.",
     "evidence_ids": [
      "EV-f536aad1",
      "EV-6016b158",
      "EV-9640aba4",
      "EV-e87def7d"
     ],
     "basis": "evidence"
    },
    "wire3_relevant_fact": {
     "value": "Wire3 markets itself as a 100% fiber provider serving Central Florida with local support and business-grade reliability.",
     "evidence_ids": [
      "EV-e98eed56",
      "EV-e3110146"
     ],
     "basis": "evidence"
    }
   },
   "price": {
    "market_description": {
     "value": "Price positioning is heavily promotional: national providers commonly advertise low first‑year rates or bundled discounts (e.g., Spectrum $30–$60 tiers, T‑Mobile discounted credits), with standard rates often higher after promo periods.",
     "evidence_ids": [
      "EV-f536aad1",
      "EV-83e823a3",
      "EV-f22ef459"
     ],
     "basis": "evidence"
    },
    "wire3_relevant_fact": {
     "value": "Wire3's public messaging emphasizes transparent pricing and no hidden fees for local businesses, but specific consumer retail price tiers were not available in the collected evidence.",
     "evidence_ids": [
      "EV-e3110146",
      "EV-beca7d7f"
     ],
     "basis": "evidence"
    }
   },
   "place": {
    "market_description": {
     "value": "Availability varies by technology: cable/HFC (Spectrum) covers broad footprints; AT&T and Quantum/other regional fiber offer fiber to select neighborhoods; T‑Mobile's fixed wireless reaches large areas quickly where wireless coverage exists.",
     "evidence_ids": [
      "EV-a5e160fb",
      "EV-6016b158",
      "EV-e87def7d",
      "EV-9640aba4"
     ],
     "basis": "evidence"
    },
    "wire3_relevant_fact": {
     "value": "Wire3 is expanding fiber builds in Space Coast and Central Florida communities (e.g., Merritt Island announcement).",
     "evidence_ids": [
      "EV-971de517"
     ],
     "basis": "evidence"
    }
   },
   "promotion": {
    "market_description": {
     "value": "Promotions include first-year discounts, bundled mobile/TV credits, mail-in rebates and bill‑credit offers; providers use these to lower initial acquisition cost while standard rates apply after the promo period.",
     "evidence_ids": [
      "EV-f536aad1",
      "EV-83e823a3",
      "EV-f22ef459"
     ],
     "basis": "evidence"
    },
    "wire3_relevant_fact": {
     "value": "Wire3's available marketing highlights reliability and local service rather than national-style loss‑leader promotions.",
     "evidence_ids": [
      "EV-e3110146",
      "EV-beca7d7f"
     ],
     "basis": "evidence"
    }
   },
   "people": {
    "market_description": {
     "value": "Customer experience channels include in‑region technician teams, national call centers, retail stores, and online support; local presence is marketed as a differentiator by regional ISPs.",
     "evidence_ids": [
      "EV-c6448697",
      "EV-beca7d7f",
      "EV-ad8e4713"
     ],
     "basis": "evidence"
    },
    "wire3_relevant_fact": {
     "value": "Wire3 highlights Florida/Georgia based support staff and local technicians as a service differentiator for small businesses.",
     "evidence_ids": [
      "EV-beca7d7f",
      "EV-267cec38"
     ],
     "basis": "evidence"
    }
   },
   "process": {
    "market_description": {
     "value": "Installation and provisioning options range from self‑install gateways (T‑Mobile) to scheduled professional fiber installs (AT&T/Quantum); billing and promotional credit processes vary and are often subject to eligibility conditions.",
